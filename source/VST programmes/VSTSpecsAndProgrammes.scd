BMMultichannelPluginSpec('IEM 3rd ord St 2-3', 			// name
	{|plugin, numInputs, numOutputs, inputs| // ugenGraphFunc
		VSTPlugin.ar(inputs, 14);
	},
	nil,
			{|plugin| plugin.attributes[\controller].editor; nil },
	nil, 							// presets
	"IEM 3rd order ambisonic decoder, ACN/SN3D\noutput speaker order: FL FR WL WR SL SR RR RL HFL HFR HRL HRR KL KR",				// description
	nil, 								// use defaultAttributes
	[16, 16],								// inRange
	[14, 14],								// outRange
	{|plugin|
		var controller;
		{
					0.5.wait;
					controller = VSTPluginController(plugin.synth);
					controller.open("AllRADecoder", editor: true);
					0.5.wait;
					controller.setProgramData(~vstProgrammes[\studio2_3IEM]);
					plugin.attributes[\controller] = controller;
				}.fork;
			}, 							// setupFunc
	nil								// cleanupFunc

);

BMMultichannelPluginSpec('Dirac 3rd ord St 2-3', 			// name
	{|plugin, numInputs, numOutputs, inputs| // ugenGraphFunc
		VSTPlugin.ar(inputs, 14);
	},
	nil,
			{|plugin| plugin.attributes[\controller].editor; nil },
	nil, 							// presets
	"Dirac 3rd order parametric ambisonic decoder, ACN/SN3D\noutput speaker order: FL FR WL WR SL SR RR RL HFL HFR HRL HRR KL KR",				// description
	nil, 								// use defaultAttributes
	[16, 16],								// inRange
	[14, 14],								// outRange
	{|plugin|
		var controller;
		{
					0.5.wait;
					controller = VSTPluginController(plugin.synth);
					controller.open("hodirac_decoder", editor: true);
					0.5.wait;
					controller.setProgramData(~vstProgrammes[\studio2_3Dirac]);
					plugin.attributes[\controller] = controller;
				}.fork;
			}, 							// setupFunc
	nil								// cleanupFunc

);
	