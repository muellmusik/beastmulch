\f0\fs18 \cf0 Check out a copy of the SC project.\
\
Build the Synth and Plugin projects\
	-make sure to select the 'Deployment' build configuration.\
\
Delete Main, Platform and SCSADemo in Standalone\\ Resources/SCClassLibrary/\
\
Modify existing version of Main:startup to this:\
\
	startup \{	\
		\cf2 var\cf0  mainpath, mainlocStr, rootdir;\
		\cf3 // setup the platform first so that class initializers can call platform methods.\cf0 \
		\cf3 // create the platform, then intialize it so that initPlatform can call methods\cf0 \
		platform = \cf2 this\cf0 .platformClass.new;\
		platform.initPlatform;\
		\cf2 super\cf0 .startup;\
		\
		\cf3 // set the 's' interpreter variable to the default server.\cf0 \
		interpreter.s = \cf2 Server\cf0 .default;\
		\cf2 GUI\cf0 .fromID( \cf2 this\cf0 .platform.defaultGUIScheme );\
		\cf2 GeneralHID\cf0 .fromID( \cf2 this\cf0 .platform.defaultHIDScheme );\
		mainlocStr = \cf2 thisMethod\cf0 .filenameSymbol.asString;\
		rootdir = mainlocStr[0..mainlocStr.size - 38]; \
		\cf2 SynthDef\cf0 .synthDefDir_(rootdir ++ \cf4 "synthdefs"\cf0 );\
		\cf2 this\cf0 .platform.startup;\
		\cf2 StartUp\cf0 .run;\
		(\
			osx: \cf4 "Welcome to BEASTmulch System, type cmd-d for help"\cf0 ,\
			linux: \cf4 "Welcome to SuperCollider, for help type ctrl-c ctrl-h (Emacs) or :SChelp (vim)"\cf0 ,\
		 	windows: \cf4 "Welcome to SuperCollider, press F1 for help"\cf0 \
		 ).at(platform.name).postln;\
		\
		\cf2 thisProcess\cf0 .interpreter.executeFile(rootdir ++ \cf4 "SCClassLibrary/Master.rtf"\cf0 );\
	\}\
	\
modify existing OSXPlatform:startup to not make internal server window, load Startup files or add Help Tree\
\
Replace Standalone Applications/English.lproj/Credits.rtf with Credits.rtfd (update rev) from svn
